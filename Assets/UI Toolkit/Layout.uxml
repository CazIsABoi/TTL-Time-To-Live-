            <ui:ProgressBar value="100" title="" name="health-bar" class="hud-panel" style="-unity-background-image-tint-color: rgb(78, 253, 46); min-width: auto; max-width: none; background-color: rgb(255, 255, 255); top: 0; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&amp;guid=bc162747ff727e7439af08583218ccca&amp;type=3#ArchivoBlack-Regular&quot;); color: rgb(255, 255, 255); width: 500px;"/>
            <ui:Button text="Start Next Wave" name="wave-button" enabled="true" class="wave-button" style="width: 300px; height: 100px; min-width: 10%; min-height: 25px; justify-content: flex-start; align-items: auto; align-self: center; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&amp;guid=bc162747ff727e7439af08583218ccca&amp;type=3#ArchivoBlack-Regular&quot;); font-size: initial; text-shadow: 3px 3px 0 rgba(0, 0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; white-space: normal; text-overflow: clip; -unity-text-align: middle-center; -unity-text-auto-size: best-fit 10px 100px;"/>
