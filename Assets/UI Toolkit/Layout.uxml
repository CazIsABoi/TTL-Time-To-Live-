    <ui:VisualElement name="HUD" picking-mode="Ignore" style="flex-grow: 1;">
        <ui:VisualElement name="top-row" picking-mode="Ignore" class="health-row" style="flex-grow: 0; text-shadow: 3px 0 0 rgba(0, 0, 0, 0);">
