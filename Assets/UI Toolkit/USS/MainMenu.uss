/* Field kit — Main Menu (video backdrop) */
:root {
    --green: rgb(154, 241, 78);
    --green-hover: rgb(103, 238, 51);
    --green-press: rgb(80, 200, 40);
    --kit-bg: rgba(28, 26, 24, 0.88);
    --kit-bg-solid: rgb(40, 36, 31);
    --kit-edge: rgb(18, 16, 14);
    --kit-text: rgb(220, 220, 218);
    --kit-muted: rgb(150, 148, 142);
    --kit-danger: rgb(238, 90, 78);
}

.menu-root {
    position: relative;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.video-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(20, 28, 24);
    -unity-background-scale-mode: scale-and-crop;
}

.video-veil {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 12, 10, 0.42);
}

.menu-chrome {
    position: relative;
    flex-grow: 1;
    flex-direction: column;
    padding: 36px 40px 48px 40px;
    min-height: 0;
}

.header {
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 28px;
}

.brand-title {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 56px;
    letter-spacing: 2px;
    margin-bottom: 4px;
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
}

.live-timer {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--green);
    font-size: 36px;
    letter-spacing: 4px;
    margin-bottom: 10px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.brand-subtitle {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 14px;
    letter-spacing: 1px;
    white-space: normal;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.body-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    min-height: 0;
    min-width: 0;
}

.menu-left {
    flex-grow: 0;
    flex-shrink: 0;
    width: 320px;
    justify-content: flex-end;
    padding-right: 28px;
    padding-bottom: 8px;
}

.menu-panel {
    background-color: var(--kit-bg);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--kit-edge);
    border-right-color: var(--kit-edge);
    border-bottom-color: var(--kit-edge);
    border-left-color: var(--kit-edge);
    border-top-left-radius: 6px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 2px;
    padding: 20px;
    width: 100%;
}

.side-box {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 280px;
    max-width: 560px;
    margin-left: auto;
    flex-direction: column;
    background-color: var(--kit-bg);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--kit-edge);
    border-right-color: var(--kit-edge);
    border-bottom-color: var(--kit-edge);
    border-left-color: var(--kit-edge);
    border-top-left-radius: 6px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 2px;
    padding: 14px;
    min-height: 0;
}

.stage-tabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 12px;
}

.stage-tab {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    height: 36px;
    margin-right: 8px;
    padding: 0 16px;
    background-color: var(--kit-bg-solid);
    color: var(--kit-muted);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    font-size: 13px;
    letter-spacing: 1px;
}

.stage-tab:hover {
    color: var(--kit-text);
}

.stage-tab.selected {
    background-color: var(--green);
    color: rgb(20, 24, 18);
}

.stage-body {
    position: relative;
    flex-grow: 1;
    min-height: 0;
}

.stage-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    min-height: 0;
    padding: 4px;
}

.stage-panel.hidden {
    display: none;
}

.notes-scroll {
    flex-grow: 1;
    min-height: 0;
}

.notes-body {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 14px;
    white-space: normal;
    letter-spacing: 0.5px;
    padding: 4px;
}

.menu-button {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    height: 52px;
    margin-bottom: 12px;
    padding: 0 16px;
    background-color: var(--kit-bg-solid);
    color: var(--kit-text);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
}
.menu-button:hover { background-color: rgb(55, 50, 44); }
.menu-button.primary {
    background-color: var(--green);
    color: rgb(20, 24, 18);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    height: 58px;
    font-size: 20px;
}
.menu-button.primary:hover { background-color: var(--green-hover); }
.menu-button.danger:hover { background-color: var(--kit-danger); color: rgb(20, 10, 10); }

.menu-hint {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 12px;
    letter-spacing: 1px;
    margin-top: 4px;
}

.version-label {
    position: absolute;
    right: 16px;
    bottom: 12px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: rgb(160, 165, 158);
    font-size: 12px;
    letter-spacing: 1px;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    min-height: 36px;
}
.settings-label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 14px;
    letter-spacing: 1px;
    flex-grow: 1;
}
.settings-value {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 14px;
    min-width: 48px;
    -unity-text-align: middle-right;
    margin-right: 12px;
}
.settings-slider { width: 160px; height: 20px; margin: 0; }

.play-iris {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.play-iris.hidden { display: none; }
.iris-circle {
    width: 40px;
    height: 40px;
    border-top-left-radius: 9999px;
    border-top-right-radius: 9999px;
    border-bottom-right-radius: 9999px;
    border-bottom-left-radius: 9999px;
    background-color: rgb(0, 0, 0);
    scale: 0.05 0.05;
    transition-property: scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-in;
}
.iris-circle.expand { scale: 90 90; }
