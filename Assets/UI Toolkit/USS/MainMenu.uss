/* Field kit — Main Menu */
:root {
    --green: rgb(154, 241, 78);
    --green-hover: rgb(103, 238, 51);
    --green-press: rgb(80, 200, 40);
    --kit-bg: rgba(28, 26, 24, 0.88);
    --kit-bg-solid: rgb(40, 36, 31);
    --kit-edge: rgb(18, 16, 14);
    --kit-text: rgb(220, 220, 218);
    --kit-muted: rgb(150, 148, 142);
    --kit-danger: rgb(238, 90, 78);
    --kit-danger-hover: rgb(255, 120, 100);
}

.menu-root {
    flex-grow: 1;
    flex-direction: row;
    align-items: stretch;
    justify-content: flex-start;
    background-color: rgba(12, 14, 18, 0.35);
    padding: 48px 56px;
}

.menu-left {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    max-width: 520px;
    padding-right: 40px;
}

.menu-right {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-end;
    padding-bottom: 8px;
}

.idle-label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: rgb(120, 122, 128);
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 10px;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

/* Black circle iris wipe on Play */
.play-iris {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.play-iris.hidden {
    display: none;
}

.iris-circle {
    width: 40px;
    height: 40px;
    border-top-left-radius: 9999px;
    border-top-right-radius: 9999px;
    border-bottom-right-radius: 9999px;
    border-bottom-left-radius: 9999px;
    background-color: rgb(0, 0, 0);
    scale: 0.05 0.05;
    transition-property: scale;
    transition-duration: 0.9s;
    transition-timing-function: ease-in;
}

.iris-circle.expand {
    scale: 90 90;
}


.brand-kicker {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 14px;
    letter-spacing: 4px;
    margin-bottom: 12px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.brand-title {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 56px;
    letter-spacing: 1px;
    white-space: normal;
    margin-bottom: 8px;
    text-shadow: 3px 3px 0 rgb(0, 0, 0);
    -unity-text-align: middle-left;
}

.brand-subtitle {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 16px;
    letter-spacing: 1px;
    margin-bottom: 36px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.menu-panel {
    background-color: var(--kit-bg);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--kit-edge);
    border-right-color: var(--kit-edge);
    border-bottom-color: var(--kit-edge);
    border-left-color: var(--kit-edge);
    border-top-left-radius: 6px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 2px;
    padding: 20px;
    min-width: 280px;
    max-width: 340px;
}

.menu-button {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    height: 52px;
    margin-bottom: 12px;
    padding: 0 16px;
    background-color: var(--kit-bg-solid);
    color: var(--kit-text);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    border-left-color: rgb(0, 0, 0);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-align: middle-left;
    transition-property: background-color, translate, scale;
    transition-duration: 0.12s;
}

.menu-button:hover {
    background-color: rgb(55, 50, 44);
    translate: 4px 0;
}

.menu-button:active {
    scale: 0.98 0.98;
}

.menu-button.primary {
    background-color: var(--green);
    color: rgb(20, 24, 18);
    -unity-text-align: middle-center;
    letter-spacing: 3px;
    height: 58px;
    font-size: 20px;
}

.menu-button.primary:hover {
    background-color: var(--green-hover);
    translate: 0 0;
}

.menu-button.primary:active {
    background-color: var(--green-press);
}

.menu-button.danger:hover {
    background-color: var(--kit-danger);
    color: rgb(20, 10, 10);
}

.menu-hint {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 12px;
    letter-spacing: 1px;
    margin-top: 8px;
    margin-bottom: 0;
}

.version-label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: rgb(110, 112, 118);
    font-size: 12px;
    letter-spacing: 1px;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

/* Settings overlay */
.settings-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(8, 10, 12, 0.72);
    align-items: center;
    justify-content: center;
}

.settings-overlay.hidden {
    display: none;
}

.settings-panel {
    min-width: 420px;
    max-width: 520px;
    background-color: var(--kit-bg);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-color: var(--kit-edge);
    border-right-color: var(--kit-edge);
    border-bottom-color: var(--kit-edge);
    border-left-color: var(--kit-edge);
    border-top-left-radius: 6px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 2px;
    padding: 24px;
}

.settings-title {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 22px;
    letter-spacing: 3px;
    margin-bottom: 20px;
    text-shadow: 2px 2px 0 rgb(0, 0, 0);
}

.settings-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    min-height: 36px;
}

.settings-label {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-muted);
    font-size: 14px;
    letter-spacing: 1px;
    flex-grow: 1;
}

.settings-value {
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/ArchivoBlack-Regular.ttf?fileID=12800000&guid=bc162747ff727e7439af08583218ccca&type=3#ArchivoBlack-Regular");
    color: var(--kit-text);
    font-size: 14px;
    min-width: 48px;
    -unity-text-align: middle-right;
    margin-right: 12px;
}

.settings-slider {
    width: 180px;
    height: 20px;
    margin: 0;
}

.settings-actions {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 18px;
}

.settings-actions .menu-button {
    min-width: 120px;
    margin-bottom: 0;
    margin-left: 10px;
    -unity-text-align: middle-center;
}
