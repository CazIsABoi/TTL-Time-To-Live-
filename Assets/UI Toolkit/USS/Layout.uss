:root {
    --green: rgb(154, 241, 78);
    --green-hover: rgb(103, 238, 51);
}

.hud-panel {
    translate: 0 0;
    opacity: 1;
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out;
}

.hud-panel.exit-up {
    translate: 0 -160px;
    opacity: 0;
    transition-timing-function: ease-in;
}
.hud-panel.exit-right {
    translate: 240px 0;
    opacity: 0;
    transition-timing-function: ease-in;
}

/* Instant hide so the first frame is already off-screen (no flash) */
.hud-panel.intro-hold,
.wave-button.intro-hold {
    transition-duration: 0s;
}

.hud-panel.exit-down {
    translate: 0 160px;
    opacity: 0;
    transition-timing-function: ease-in;
}

.hud-panel.exit-left {
    translate: -240px 0;
    opacity: 0;
    transition-timing-function: ease-in;
}

.unity-progress-bar__progress {
    -unity-background-image-tint-color: rgb(238, 51, 51);
    background-color: rgb(103, 238, 51);
}

.unity-progress-bar__background {
    -unity-background-image-tint-color: rgb(57, 62, 75);
    background-color: rgb(76, 76, 96);
}

.wave-button {
    position: absolute;
    translate: 0 0;
    scale: 1;
    opacity: 1;
    background-color: var(--green);
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-in;
}

.wave-button.disabled {
    transition-property: opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.wave-button:hover {
    background-color: var(--green-hover);
}

.wave-button:active {
    background-color: rgb(80, 200, 40);
}

.wave-button.exit-down {
    translate: 0 160px;
    opacity: 0;
}

.wave-button.exit-up {
    translate: 0 -160px;
    opacity: 0;
    transition-timing-function: ease-in;
}

.rarity-common {
    border-left-color: rgb(127, 127, 127);
    border-right-color: rgb(127, 127, 127);
    border-top-color: rgb(127, 127, 127);
    border-bottom-color: rgb(127, 127, 127);
    border-top-width: 3px;
    border-right-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 30px;
}

.rarity-common #banner {
    background-color: rgb(127, 127, 127);
}

